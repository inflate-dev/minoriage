# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 自宅Jetson（SfM/YOLO処理サーバー）のURL
NEXT_PUBLIC_LOCAL_SERVER_URL=

# Jetsonへの通信を認証するAPIキー（doc/spec.md 9章）
# Jetson側で同じ値を検証し、一致しないリクエストは拒否すること
NEXT_PUBLIC_JETSON_API_KEY=

# アプリのベースURL（Stripeのリダイレクト等で使用）
NEXT_PUBLIC_APP_URL=

# Stripe
STRIPE_SECRET_KEY=
